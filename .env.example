# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google AI Studio API Key (100% Free Tier from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Telegram usernames authorized to search (comma-separated, without @)
# If left empty, the bot will answer anyone who messages it.
ALLOWED_USERNAMES=

# HTTP Port for Render health check
PORT=3000
